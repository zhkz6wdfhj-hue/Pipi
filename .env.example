# =============================================================================
# Melin_clo — omgevingsvariabelen
# =============================================================================
#
# Kopieer dit bestand naar .env.local en vul in wat je nodig hebt:
#
#   cp .env.example .env.local
#
# .env.local staat in .gitignore en komt dus nooit in je repository terecht.
# Zet dezelfde variabelen ook in Vercel onder Settings → Environment Variables.
#
# De winkel draait óók zonder dat je hier iets invult. De checkout gaat dan in
# simulatiemodus en e-mails worden in de terminal getoond in plaats van
# verstuurd. Zo kun je alles uitproberen voordat je accounts aanmaakt.


# -----------------------------------------------------------------------------
# 1. Adres van de site
# -----------------------------------------------------------------------------
# Zonder afsluitende schuine streep. Wordt gebruikt voor canonieke URL's, de
# sitemap, de links in e-mails en de Open Graph-afbeelding.
# Lokaal:  http://localhost:3000
# Live:    https://www.melin-clo.nl
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. Mollie — betalingen (iDEAL, Bancontact, creditcard)
# -----------------------------------------------------------------------------
# Maak een account op https://www.mollie.com en haal je sleutel op onder
# Ontwikkelaars → API-sleutels.
#
#   Leeg gelaten  → simulatiemodus: je doorloopt de hele bestelstroom zonder
#                   betaalaccount. Alleen bedoeld om te testen.
#   test_...      → echte Mollie-omgeving zonder echt geld. Je kiest in het
#                   Mollie-scherm zelf of de betaling slaagt of mislukt.
#   live_...      → echte betalingen. Zet deze pas neer als je klaar bent.
#
# Let op: zet de live sleutel alleen in Vercel, nooit in een bestand dat je
# commit.
MOLLIE_API_KEY=

# Mollie kan een webhook op localhost niet bereiken. Tijdens het ontwikkelen
# haalt de site de betaalstatus daarom op zodra de klant terugkeert uit het
# betaalscherm; je hoeft hier niets voor in te stellen. Wil je de webhook wél
# lokaal testen, gebruik dan een tunnel (bijvoorbeeld `ngrok http 3000`) en zet
# de publieke URL hierboven in NEXT_PUBLIC_SITE_URL.


# -----------------------------------------------------------------------------
# 3. Resend — e-mail versturen
# -----------------------------------------------------------------------------
# Voor de bevestigingsmail aan de klant, het interne besteloverzicht, het
# contactformulier en de nieuwsbrief. Maak een account op https://resend.com,
# verifieer je domein en maak een API-sleutel aan.
#
# Leeg gelaten → e-mails worden netjes in de terminal getoond in plaats van
#                verstuurd. Handig tijdens het bouwen.
RESEND_API_KEY=

# Het afzenderadres moet op een domein staan dat je bij Resend hebt
# geverifieerd. Pas het ook aan in src/data/site.ts (site.emailFrom).


# -----------------------------------------------------------------------------
# 4. Nieuwsbrief — handtekening voor de bevestigingslink
# -----------------------------------------------------------------------------
# Een willekeurige, lange tekenreeks. Hiermee wordt de bevestigingslink van de
# dubbele opt-in ondertekend, zodat niemand een aanmelding voor een ander adres
# kan bevestigen. Maak er een met:
#
#   openssl rand -hex 32
#
# Laat je hem leeg, dan wordt een vaste ontwikkelsleutel gebruikt. Voor livegang
# is invullen verplicht.
NEWSLETTER_SECRET=
